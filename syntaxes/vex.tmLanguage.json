	"name": "vex",
	"patterns": [

		{
			"include": "#comments_block"
		},
		{
			"include": "#comments_inline"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings_double"
		},
		{
			"include": "#strings_single"
		},
		{
			"include": "#exposed_variables"
