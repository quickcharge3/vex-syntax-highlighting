	"repository": {

		"comments_block":{
			"patterns": [
				{
					"begin": "/\\*",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.vex"
						}
					},
					"end": "\\*/",
					"name": "comment.block.vex"
				}
			]
		},

		"comments_inline":{
			"patterns": [
				{
					"begin": "//",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.vex"
						}
					},
					"end": "\n",
					"name": "comment.inline.vex"
				}
			]
		},

		"keywords": {
			"patterns": [{
				"name": "keyword.control.vex",
